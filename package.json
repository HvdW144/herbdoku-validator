    "url": "git+https://github.com/HvdW144/herbdoku-validator.git"
  },
  "keywords": [
    "sudoku",
    "validator",
    "sudoku-validator"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@eslint/js": "^9.16.0",
    "@mitata/counters": "^0.0.8",
    "@types/jest": "^29.5.12",
    "eslint": "^9.16.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "mitata": "^1.0.34",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.16.0"
  }
